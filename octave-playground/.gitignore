# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# jupyter lite build cache
.jupyterlite.doit.db

# generated by `jupyter lite build` (scripts/build-kernel-assets.sh) --
# hundreds of MB of WASM/kernel packages, not source. public/assets/libz.so
# and unpack-*.wasm are vendored copies from this, also generated --
# see scripts/vendor-worker-assets.mjs.
public/xeus/
public/assets/

# vendored from ../engr183-harness by scripts/sync_harness.py, never
# hand-edited -- see DESIGN.md §6. .sync_manifest.json tracks drift for
# these and must stay gitignored alongside them, or a fresh clone falsely
# detects "drift" against a manifest whose files were never checked out.
vfs/
scripts/.sync_manifest.json

# public/starters/* (not a bare trailing-slash "public/starters/") so git
# still traverses the directory and the negation below can take effect --
# once a directory itself is excluded, git prunes it and never evaluates
# patterns for its children, no matter how they're negated.
public/starters/*

# ...except the Scratch Pad's starter (src/units/index.ts's scratchUnit):
# there's no engr183-harness counterpart to sync it from, it's hand-authored
# playground-only content, so it's real source and must be tracked.
!public/starters/scratch/
